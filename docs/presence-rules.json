{
  "rules": {
    "essence-island": {
      "presence": {
        "$room": {
          ".read": true,
          "$id": {
            ".write": "$room.matches(/^[A-Za-z0-9_-]{1,20}$/) && $id.matches(/^[a-z0-9]{6,12}$/)",
            ".validate": "newData.hasChildren(['n', 'x', 'y', 't'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "t": { ".validate": "newData.val() == now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
